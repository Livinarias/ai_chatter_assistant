<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- =============================================================
             Cron: Vacuum expired ai.usage.log entries

             Although TransientModel handles TTL natively, this explicit
             cron ensures timely cleanup in busy instances.
             ============================================================= -->
        <record id="ir_cron_vacuum_ai_usage_log" model="ir.cron">
            <field name="name">AI Assistant: Clean Up Usage Logs</field>
            <field name="model_id" ref="model_ai_usage_log"/>
            <field name="state">code</field>
            <field name="code">model._transient_vacuum()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
